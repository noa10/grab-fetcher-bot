# Daily Telegram heartbeat — one message a day proving the pipeline produced data.
#
# Failure alerting only fires on a non-zero exit. A run that exits 0 while
# extracting nothing (selector drift, empty History tab) looks healthy, and that
# is the failure mode you notice days later. This compares today's order count
# against the shop's own trailing 7-day median and reports reviews as a second
# signal that the daily feedback job is still writing.
#
# Run at 22:45 MYT, after the last poll of the trading window has finished.
#
#   sudo cp deploy/grab-heartbeat.service deploy/grab-heartbeat.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now grab-heartbeat.timer
#
# Manual check: node scripts/daily-heartbeat.js --dry-run
[Unit]
Description=Grab daily heartbeat (orders + reviews summary to Telegram)
Documentation=https://github.com/noa10/grab-fetcher-bot
After=network-online.target
Wants=network-online.target
OnFailure=grab-alert@%N.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/grab-fetcher-bot

# Resolve node through the same wrapper the poll uses; /usr/bin/npm does not
# exist on this host and the Hermes toolchain path changes on upgrade.
ExecStart=/home/ubuntu/.local/bin/grab-fetcher-node scripts/daily-heartbeat.js

TimeoutStartSec=180
Nice=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=grab-heartbeat
