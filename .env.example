# Grab Merchant Portal Credentials
GRAB_USERNAME=your_grab_merchant_email@example.com
GRAB_PASSWORD=your_grab_merchant_password

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/grab-orders?retryWrites=true&w=majority

# Bot Configuration
# Operating hours: 11:00 AM - 10:30 PM MYT (GMT+8)
POLLING_INTERVAL_MINUTES=5
MAX_RETRIES=3
HEADLESS_MODE=true
SCREENSHOT_ENABLED=true

# Server Configuration (Optional - for dashboard)
PORT=63173
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Anti-Detection Settings
USER_AGENT_ROTATION=true
RANDOM_DELAYS=true
MIN_DELAY_MS=1000
MAX_DELAY_MS=3000

# Screenshot Storage (Optional - for cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Dashboard Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Session Secret
SESSION_SECRET=your_random_session_secret
