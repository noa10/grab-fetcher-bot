# Grab Merchant Portal Credentials
GRAB_USERNAME=your_grab_merchant_email@example.com
GRAB_PASSWORD=your_grab_merchant_password

# Grab store id used by the customer-feedback scraper (npm run fetch-feedback).
# Optional: when unset, the built-in default is used. The default only covers the
# one store this bot was written for (Mad Krapow - Subang Permai), so a second
# store requires the correct id here — it cannot be derived from the portal's
# merchantSelector, which holds the master-account id that the feedback API
# rejects. Find a store's id by opening the Feedback tab and reading the
# `merchantid` header its own request sends.
GRAB_STORE_ID=

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/grab-orders?retryWrites=true&w=majority

# Bot Configuration
# Trading hours in MYT (GMT+8), as comma-separated windows. The bot polls every
# POLLING_INTERVAL_MINUTES during these windows and stays completely off the
# Grab portal outside them. Multiple windows allow for breaks, e.g. the default
# below skips 15:00-17:00. A single window works too: 11:00-22:30.
OPERATING_HOURS=11:00-15:00,17:00-22:30
POLLING_INTERVAL_MINUTES=5
MAX_RETRIES=3
HEADLESS_MODE=true
SCREENSHOT_ENABLED=true

# Server Configuration (Optional - for dashboard)
PORT=63173
NODE_ENV=development

# Session cookie "secure" flag. Leave unset to auto-detect.
# Set to true ONLY when TLS is terminated in front of the dashboard: a secure
# cookie over plain HTTP is discarded by the browser, so login succeeds but
# every authenticated request redirects to /login.
# COOKIE_SECURE=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Anti-Detection Settings
USER_AGENT_ROTATION=true
RANDOM_DELAYS=true
MIN_DELAY_MS=1000
MAX_DELAY_MS=3000

# Screenshot Storage (Optional - for cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Dashboard Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Session Secret
SESSION_SECRET=your_random_session_secret

# Marketing Analytics
ENABLE_MARKETING_ANALYTICS=true
RFM_CHAMPION_MONETARY_THRESHOLD=300
